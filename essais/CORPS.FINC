;	Banc d'essai croise codi_x86_64 / codi_TX : meme LLIR, sorties comparees.
;	Chaque ligne affichee : un numero de test (2 chiffres hexa) puis le resultat en hexa.

macro AFF n*				; affiche "nn:" puis le sommet en 16 chiffres hexa (consomme)
  LI n
  CALL , PNUM
  CALL , PHEX
end macro

macro AFF_BOOL n*			; affiche "nn:" puis V ou F selon le sommet, via BT
  local vrai, suite
  LI n
  CALL , PNUM
  BT vrai
  LI 'F'
  BRA suite
vrai:
  LI 'V'
suite:
  SYS_PUT_CHAR
  LI 10
  SYS_PUT_CHAR
end macro

	LINK 0, 512			; variables de niveau 0 : +8 .. +512

;	--- arithmetique entiere
	LI 5
	LI 3
	SUB
	AFF 1
	LI -7
	LI 2
	DIV
	AFF 2
	LI -7
	LI 2
	REMI
	AFF 3
	LI -7
	LI 2
	MODI
	AFF 4
	LI 7
	LI -2
	MODI
	AFF 5
	LI -123456789
	LI 987654321
	MUL
	AFF 6
	LI 0x8000000000000000
	ABS
	AFF 7
	LI -42
	ABS
	AFF 8
	LI -5
	CLAMP0
	AFF 9
	LI 17
	NEG
	INC
	INC
	DEC
	AFF 0x0A

;	--- logique et decalages
	LI 0xF0F0
	LI 0x0FF0
	ET
	AFF 0x10
	LI 0xF0F0
	LI 0x0FF0
	OU
	AFF 0x11
	LI 0xF0F0
	LI 0x0FF0
	OUX
	AFF 0x12
	LI 0x1234
	NON
	AFF 0x13
	LI 1
	LI 63
	SHL
	AFF 0x14
	LI -256
	LI 4
	SHR
	AFF 0x15
	LI -256
	LI 4
	SAR
	AFF 0x16
	LI 3
	LI 65
	SHL
	AFF 0x17

;	--- champs de bits
	LI 0x12345678
	LI 8
	LI 12
	UBFX
	AFF 0x20
	LI 0xF00
	LI 8
	LI 4
	SBFX
	AFF 0x21
	LI 0xFFFF
	LI 5
	LI 4
	LI 4
	BFI
	AFF 0x22

;	--- virgule fixe
	LI 7
	LI 1000
	LI 3
	CVTIX
	AFF 0x28
	LI 2333
	LI 3
	LI 1000
	CVTXI
	AFF 0x29
	LI -2333
	LI 3
	LI 1000
	CVTXI
	AFF 0x2A
	LI 0x10000000000
	LI 0x40000000
	LI 0x100000
	CVTIX
	AFF 0x2B

;	--- comparaisons entieres (par branchement : la reference n'ecrit que l'octet bas)
	LI 5
	LI 3
	CGT
	AFF_BOOL 0x30
	LI -5
	LI 3
	CGT
	AFF_BOOL 0x31
	LI 3
	LI 3
	CGE
	AFF_BOOL 0x32
	LI 3
	LI 3
	CNE
	AFF_BOOL 0x33
	LI -1
	LI 0
	CLT
	AFF_BOOL 0x34
	LI 4
	LI 4
	CLE
	AFF_BOOL 0x35
	LI 4
	LI 4
	CEQ
	AFF_BOOL 0x36

;	--- memoire : tailles, extensions, familles B et C
	LI 0x80
	SB 0, 16
	LB 0, 16
	AFF 0x40
	ULB 0, 16
	AFF 0x41
	LI 0x8001
	SW 0, 24
	LW 0, 24
	AFF 0x42
	ULW 0, 24
	AFF 0x43
	LI 0x80000002
	SD 0, 32
	LD 0, 32
	AFF 0x44
	ULD 0, 32
	AFF 0x45
	LI 0x1122334455667788
	SQ 0, 40
	LVA 0, 40			; pointeur vers +40 range en +48
	SA 0, 48
	LIQ 0, 48, 0
	AFF 0x46
	LIB 0, 48, 7
	AFF 0x47
	LI 0x99
	SIB 0, 48, 1
	LQ 0, 40
	AFF 0x48
	LVA 0, 40			; famille B avec adresse sur pile et deplacement
	LB , 6
	AFF 0x49
	LA 0, 48
	LI 0x55
	SB , 2
	LQ 0, 40
	AFF 0x4A
	LIVA 0, 48, 3
	ULB
	AFF 0x4B
	LI 0xABCD
	LVA 0, 48			; SIW avec adresse d'adresse sur pile
	LI 0x7777
	SIW , 0, 4
	DROP
	LQ 0, 40
	AFF 0x4C
	LI 1
	LI 2
	OVER
	ADD
	ADD
	AFF 0x4D

;	--- flottants
	LIF 1.5
	LIF 2.25
	FADD
	AFF 0x50
	LIF 1.5
	LIF 2.25
	FSUB
	AFF 0x51
	LIF 1.5
	LIF 2.25
	FMUL
	AFF 0x52
	LIF 1.0
	LIF 3.0
	FDIV
	AFF 0x53
	LIF 1.5
	FNEG
	AFF 0x54
	LIF -2.5
	FABS
	AFF 0x55
	LIF 1.5
	LI 3
	FEXP
	AFF 0x56
	LI -7
	CVTIF
	AFF 0x57
	LIF -3.7
	CVTFI
	AFF 0x58
	LIF 3.7
	CVTFIR
	AFF 0x59
	LIF 1.0e30
	CVTFI
	AFF 0x5A
	LIF 0.0
	LIF 0.0
	FDIV
	DUP
	SQ 0, 56			; NaN conserve en +56
	AFF 0x5B
	LQ 0, 56
	LIF 1.0
	FCNE
	AFF_BOOL 0x5C
	LQ 0, 56
	LIF 1.0
	FCEQ
	AFF_BOOL 0x5D
	LQ 0, 56
	LIF 1.0
	FCLT
	AFF_BOOL 0x5E
	LIF 1.0
	LIF 2.0
	FCLE
	AFF_BOOL 0x5F
	LIF 2.0
	LIF 1.0
	FCGT
	AFF_BOOL 0x60
	LIF 2.0
	LIF 2.0
	FCGE
	AFF_BOOL 0x61

;	--- blocs : deux tableaux de 4 octets en +64 et +72
	LI 0x04030201
	SD 0, 64
	LI 0x04030501
	SD 0, 72
	LVA 0, 64
	LI 4
	LVA 0, 72
	BLKCMP
	AFF 0x68
	LVA 0, 64
	LI 4
	LVA 0, 64
	BLKCMP
	AFF 0x69
	LVA 0, 64			; ( @g lg @d ld ) octets non signes
	LI 4
	LVA 0, 72
	LI 4
	LEXCMP 1, 0
	AFF 0x6A
	LVA 0, 64
	LI 3
	LVA 0, 64
	LI 4
	LEXCMP 1, 0
	AFF 0x6B
	LVA 0, 80			; copie de +64 vers +80
	LI 4
	LVA 0, 64
	BLKMOV
	LD 0, 80
	AFF 0x6C
	LVA 0, 80
	LI 4
	LVA 0, 72
	BLKOUX
	LD 0, 80
	AFF 0x6D
	LVA 0, 80
	LI 4
	LVA 0, 72
	BLKOU
	LD 0, 80
	AFF 0x6E
	LVA 0, 80
	LI 4
	LVA 0, 64
	BLKAND
	LD 0, 80
	AFF 0x6F
	LVA 0, 80
	LI 4
	BLKNOT
	LD 0, 80
	AFF 0x70
	LI 0xFFFF
	SW 0, 88
	LI 0x0001
	SW 0, 96
	LVA 0, 88			; composants 16 bits signes : -1 < 1
	LI 2
	LVA 0, 96
	LI 2
	LEXCMP 2, 1
	AFF 0x71
	LVA 0, 88			; les memes non signes : 65535 > 1
	LI 2
	LVA 0, 96
	LI 2
	LEXCMP 2, 0
	AFF 0x72

;	--- co-pile, tas, appel indirect
	LI 20
	CO_VAR
	DUP
	SA 0, 104
	LI 0x0BADCAFE
	SQ , 8
	LA 0, 104
	LQ , 8
	AFF 0x78
	LI 24
	HEAP_ALLOC
	SA 0, 112
	LA 0, 112
	LI 0x5EED
	SQ , 16
	LA 0, 112
	LQ , 16
	AFF 0x79
	LI 0x7A
	CALL , PNUM
	LI 0xCAFE
	LSPA , PHEX
	CALLI

;	--- exceptions : contexte en +200 (296 octets), sommet des contextes en +8
	LI 0
	SQ 0, 200			; PREV_CTX = 0
	EXC_MACH 0, 200
	LCA reprise
	SQ 0, 208			; DISPATCH
	LVA 0, 200
	SQ 0, 8				; sommet de la pile des contextes
	LI 0x1111			; valeurs laissees sur la pile : jetees par le deroulage
	LI 0x2222
	CALL , LEVER			; appel a un niveau 1 qui leve
	LI 0xBAD
	AFF 0x7F
reprise:
	LQ 0, 8
	AFF 0x80			; sommet des contextes depile : 0
	LI 0xE0
	AFF 0x81
	LI 7				; la pile et les retours doivent etre sains apres le deroulage
	CALL , PHEX
	SYS_EXIT 0

;	--- sous-programmes

PNUM_:					; affiche le parametre en 2 chiffres hexa suivi de ':'
	LINK 1, 0
	LQ 1, -8
	LI 4
	SHR
	CALL , CHIFFRE
	LQ 1, -8
	LI 15
	ET
	CALL , CHIFFRE
	LI ':'
	SYS_PUT_CHAR
	UNLINKR 1
	RTD 8

CHIFFRE_:				; affiche un chiffre hexa
	LINK 2, 0
	LQ 2, -8
	DUP
	LI 9
	CGT
	BF .dec
	LI 7
	ADD
.dec:
	LI '0'
	ADD
	SYS_PUT_CHAR
	UNLINKR 2
	RTD 8

PHEX_:					; affiche le parametre en 16 chiffres hexa et fin de ligne
	LINK 1, 8
	LI 60
	SQ 1, 8
.boucle:
	LQ 1, -8
	LQ 1, 8
	SHR
	LI 15
	ET
	CALL , CHIFFRE
	LQ 1, 8
	LI 4
	SUB
	DUP
	SQ 1, 8
	LI 0
	CGE
	BT .boucle
	LI 10
	SYS_PUT_CHAR
	UNLINKR 1
	RTD 8

LEVER_:
	LINK 1, 16
	LI 0x3333
	LI 0x4444
	CALL , LEVER2
	RTD 0

LEVER2_:
	LINK 2, 0
	LI 0x5555
	EXC_RAISE 8
